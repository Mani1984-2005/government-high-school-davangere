# ==============================================================================
# Server Runtime & Port Configuration (NEVER prefix secrets with VITE_)
# ==============================================================================
PORT=3000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ==============================================================================
# Cloud SQL PostgreSQL (Injected via runtime secrets; Object Method only)
# Do NOT define DATABASE_URL here.
# ==============================================================================
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# ==============================================================================
# Optional Redis Cache / Rate Limiter (Future distributed OTP throttling)
# ==============================================================================
REDIS_URL=

# ==============================================================================
# Transactional SMS Provider (DLT-registered Indian SMS Gateway)
# Set SMS_PROVIDER=disabled_dev in non-production environments.
# ==============================================================================
SMS_PROVIDER=disabled_dev
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=
SMS_DLT_TEMPLATE_OTP_ID=

# ==============================================================================
# Transactional Email Provider (NIC SMTP / Resend / AWS SES)
# Set EMAIL_PROVIDER=disabled_dev in non-production environments.
# ==============================================================================
EMAIL_PROVIDER=disabled_dev
EMAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_API_KEY=

# ==============================================================================
# Cryptographic Keying Material (Leave empty in repo; set in Secret Manager)
# ==============================================================================
SESSION_SECRET=
OTP_HMAC_SECRET=
DATA_HASH_PEPPER=
